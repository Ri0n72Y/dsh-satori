{
  "name": "dsh-satori",
  "version": "0.1.0",
  "description": "Satori messaging adapter for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.prepare.config.ts",
    "test": "vitest run",
    "prepare": "tsdown --config tsdown.prepare.config.ts"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "satori",
    "messaging",
    "im-adapter"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@satorijs/element": "^3.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
